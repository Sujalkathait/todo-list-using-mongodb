<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Tasks - TodoApp</title>
    <link rel="stylesheet" href="/style.css?v=3">
</head>
<body>
    <%- include('navbar') %>

    <div class="main-wrapper">
        <div class="container">
            <!-- Header Section -->
            <div class="header-section">
                <div>
                    <h1 class="page-title">My Tasks</h1>
                    <p class="page-subtitle"><%= tasks.length %> <%= tasks.length === 1 ? 'task' : 'tasks' %> in total</p>
                </div>
                <a href="/add" class="btn btn-primary">+ New Task</a>
            </div>

            <!-- Task List -->
            <% if (tasks && tasks.length > 0) { %>
                <ul class="task-list">
                    <% tasks.forEach(item => { %>
                        <li class="task-card <%= item.completed ? 'task-done' : '' %>">
                            <!-- Left: Checkbox -->
                            <a href="/toggle/<%= item._id %>" class="checkbox-circle <%= item.completed ? 'checked' : '' %>" title="Toggle complete">
                                <% if (item.completed) { %>
                                    <span>✓</span>
                                <% } %>
                            </a>

                            <!-- Middle: Task Details -->
                            <div class="task-info">
                                <h3 class="task-title"><%= item.task %></h3>
                                <% if (item.description && item.description.trim() !== '') { %>
                                    <p class="task-desc"><%= item.description %></p>
                                <% } %>
                                <div class="task-meta">
                                    <% if (item.createdAt) { %>
                                        <span class="meta-time">
                                            🕒 <%= new Date(item.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                        </span>
                                    <% } %>
                                    <% if (item.completed) { %>
                                        <span class="badge-done">Completed</span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Right: Actions -->
                            <div class="task-actions">
                                <a href="/update/<%= item._id %>" class="action-btn edit-btn" title="Edit Task">✏️</a>
                                <a href="/delete/<%= item._id %>" class="action-btn delete-btn" onclick="return confirm('Are you sure you want to delete this task?')" title="Delete Task">🗑️</a>
                            </div>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-icon">📝</div>
                    <h2>No tasks yet</h2>
                    <p>All caught up! Add a new task to stay organized.</p>
                    <a href="/add" class="btn btn-primary">+ Add New Task</a>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
